# === Watch Daemon (Automation) ===
WATCH_ENABLED="false"
WATCH_DIR="./inbox"
PROCESSED_DIR="./processed"
WATCH_INTERVAL="10"
WATCH_COLLECTION="ocr_rag"
WATCH_API_KEY="test_key_0000"

# === API Keys ===
API_KEYS="legal_team_secret_abc123:Legal Department:50.00:1.00,test_key_0000:Internal Benchmark Test:1.00:0.00"

