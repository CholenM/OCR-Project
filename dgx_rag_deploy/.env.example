# === GPU ===
GPU_LAYERS="99"

# === FastAPI (RAG Service) ===
API_HOST="0.0.0.0"
API_PORT="8081"

# === Qdrant ===
QDRANT_URL="http://localhost:6333"
QDRANT_DASHBOARD="http://192.168.50.153:6333/dashboard"
QDRANT_COLLECTION="ocr_rag"

# === RAG Defaults ===
RAG_CHUNK_SIZE="1200"
RAG_TOP_K="15"

# === Memory Database ===
