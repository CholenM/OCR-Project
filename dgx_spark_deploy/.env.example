# === Model Server (llama.cpp with CUDA) ===
# Path is auto-configured by setup.sh — update if llama-server is installed elsewhere
LLAMA_SERVER_PATH="./llama.cpp/build/bin/llama-server"
MODEL_PATH="./models/LightOnOCR-2-1B-ocr-soup-F16.gguf"
MMPROJ_PATH="./models/mmproj-F32.gguf"
GPU_LAYERS="99"
CONTEXT_SIZE="16384"
MODEL_PORT="8001"
MODEL_HOST="0.0.0.0"
MODEL_TEMP="0"
IMAGE_MIN_TOKENS="1024"
MODEL_API_KEY="sk-ocr-layer1"
HEALTH_TIMEOUT="120"

# === OCR API Service ===
MODEL_URL="http://127.0.0.1:8001/v1/chat/completions"
MODEL_NAME="LightOnOCR-2-1B"
API_PORT="8080"
API_HOST="0.0.0.0"
MAX_CONCURRENCY="4"

# === Asynchronous OCR Jobs ===
OCR_JOB_DIR="./ocr_jobs"
OCR_JOB_CONCURRENCY="3"
OCR_RECOVER_JOBS_ON_STARTUP="true"
OCR_JOB_RETENTION_HOURS="24"
OCR_STATUS_POLL_SECONDS="2"

# === API Keys (format: key:user:monthly_cap:rate_per_page) ===
# Add more keys separated by commas
API_KEYS="legal_team_secret_abc123:Legal Department:50.00:1.00,test_key_0000:Internal Benchmark Test:1.00:0.00"
